{
  "name": "@rapidmx/web-client",
  "version": "0.13.0",
  "description": "RapidMX's webmail and admin console React UI for web-based clients.",
  "type": "module",
  "repository": "https://github.com/rapidmx/web-client",
  "author": "Jean-Philippe Steinmetz <rapidrests@gmail.com>",
  "license": "MPL-2.0",
  "files": [
    "apps",
    "dist"
  ],
  "exports": {
    "./*.js": {
      "import": "./dist/apps/*.js"
    },
    "./shared/styles/app.css": "./apps/shared/styles/app.css"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && shx mkdir -p dist/apps/shared/styles && shx cp apps/shared/styles/app.css dist/apps/shared/styles/app.css && node scripts/checkDistReferences.mjs",
    "lint": "eslint ./apps ./test",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch --coverage",
    "release": "npx @rapidrest/cli release",
    "prepublish": "yarn build"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
  },
  "peerDependencies": {
    "react": "19.x",
    "react-dom": "19.x"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@journeyapps/wa-sqlite": "^2.0.4",
    "@peculiar/x509": "^2.1.0",
    "@rapidmx/react-shared": "^0.15.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "asn1js": "^3.0.10",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "hash-wasm": "^4.12.0",
    "pkijs": "^3.4.0",
    "react-icons": "^5.7.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=24.0.0"
  }
}
